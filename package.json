{
  "name": "@akairos/myno",
  "version": "0.4.5",
  "description": "WeChat article WYSIWYG editor & visual typography studio",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "import": "./dist/editor/index.js",
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./menu": {
      "import": "./dist/editor/article-menu.js",
      "types": "./dist/editor/article-menu.d.ts",
      "default": "./dist/editor/article-menu.js"
    },
    "./style-config": {
      "types": "./dist/style-config.d.ts",
      "import": "./dist/style-config.js",
      "default": "./dist/style-config.js"
    },
    "./style-controls": {
      "types": "./dist/editor/style-controls.d.ts",
      "import": "./dist/editor/style-controls.js",
      "default": "./dist/editor/style-controls.js"
    },
    "./style": "./dist/styles/index.css",
    "./article.css": "./dist/styles/article.css",
    "./tokens-default.css": "./dist/styles/tokens-default.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2"
  },
  "dependencies": {
    "@akairos/milkdown-article-plugins": "^0.1.3",
    "juice": "^12.2.0",
    "postcss-selector-parser": "7.1.6"
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@types/bun": "latest",
    "typescript": "^5.7.0",
    "vite": "^7.1.10"
  }
}
